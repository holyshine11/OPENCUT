# setup-mac.sh·voices-release.sh 설정 (새 맥에 설치할 때 받는 것들)
# GPT-SoVITS 엔진: 이 커밋을 받아 patches/gpt-sovits.patch 를 적용한다. 엔진을 올리면 패치도 다시 뽑는다:
#   git -C GPT-SoVITS diff > patches/gpt-sovits.patch
SETUP_ENGINE_REPO=https://github.com/RVC-Boss/GPT-SoVITS.git
SETUP_ENGINE_COMMIT=48b1a0169a28582a8984402f82cf438d3bfa6aca
SETUP_ENGINE_PATCH=patches/gpt-sovits.patch
# 파이썬 버전과 패키지 (개발 맥 가상환경 그대로. pyopenjtalk 는 일본어 전용이고 C++ 빌드가 필요해 뺀다 — 이 맥 CLT 에서 'fstream' 오류):
#   uv pip freeze --python GPT-SoVITS/.venv/bin/python | grep -v '^pyopenjtalk==' > requirements-mac.txt
SETUP_PYTHON=3.11.12
SETUP_REQUIREMENTS=requirements-mac.txt
# 사전학습 모델: SETUP_MODELS_URL/<경로> 를 GPT-SoVITS/GPT_SoVITS/pretrained_models/<경로> 로 받는다 (합성에 쓰는 것만, 약 280MB)
#   v1·v3·v4·bigvgan·학습용 s1/s2 바탕 모델은 받지 않는다. BERT 는 중국어에만 쓰여 받지 않는다 (엔진이 처음 필요할 때 읽음)
SETUP_MODELS_URL=https://huggingface.co/lj1995/GPT-SoVITS/resolve/main
SETUP_MODELS="chinese-hubert-base/config.json chinese-hubert-base/preprocessor_config.json chinese-hubert-base/pytorch_model.bin sv/pretrained_eres2netv2w24s4ep4.ckpt"
# 언어 판별 모델 (한국어 문장 속 영어 구간을 가른다). 엔진이 pretrained_models/fast_langdetect 에서 찾고, 폴더가 없으면 받지 않고 실패한다
SETUP_LANGDETECT_URL=https://dl.fbaipublicfiles.com/fasttext/supervised-models/lid.176.bin
# 영어 발음용 NLTK 데이터 (한국어 문장 속 영어 단어). 가상환경 안(.venv/nltk_data)에 받는다 — 엔진이 일부만 스스로 받아 _eng 태거가 빠진다
SETUP_NLTK_DATA="averaged_perceptron_tagger_eng averaged_perceptron_tagger cmudict"
# 송강 울림 제거 모델 (tts.env TTS_DEREVERB_MODEL 위치로 받는다)
SETUP_DEREVERB_URL=https://huggingface.co/lj1995/VoiceConversionWebUI/resolve/main/uvr5_weights/VR-DeEchoDeReverb.pth
# 목소리 묶음 (가중치 + 참조 음성): 비공개 저장소의 GitHub Release, 태그 voices-YYYYMMDD. 가장 최근 것을 받는다
#   실제 사람 목소리라 공개 저장소(OPENCUT)에 넣지 않는다. 받으려면 이 저장소 권한이 있는 계정으로 gh 로그인해야 한다
SETUP_VOICES_REPO=holyshine11/OPENCUT-voices
SETUP_VOICES_TAG_PREFIX=voices-
SETUP_VOICES_ASSET=voices.tar
# 받은 목소리 묶음 태그를 적어 두는 파일 (같으면 다시 받지 않는다, git 제외)
SETUP_VOICES_STAMP=.voices-tag
# 설치 확인용 문장 (영어 단어를 넣어 영어 발음 경로까지 확인한다)
SETUP_CHECK_TEXT="설치가 끝났습니다. OK 사인이 나오면 시작합니다."
# 발음 검사용 Whisper small (tts.env TTS_WEB_ASR_MODEL 폴더로 받는다, 약 480MB)
SETUP_ASR_URL=https://huggingface.co/Systran/faster-whisper-small/resolve/main
SETUP_ASR_FILES="config.json model.bin tokenizer.json vocabulary.txt"
