TTS_API_HOST=127.0.0.1
TTS_API_PORT=9880
TTS_API_URL=http://$TTS_API_HOST:$TTS_API_PORT/tts
# 파일 경로는 apps/tts 폴더 기준 (읽는 쪽이 절대 경로로 바꾼다 — 폴더를 옮겨도 그대로 쓴다). tts-voices.json, tts-styles*.json 도 같다
# 합성 서버 설정 (이것만 GPT-SoVITS 폴더 기준 경로). 서버는 하나이고 목소리를 바꿀 때 가중치만 갈아 끼운다 (tts-voices.json).
#   서버가 가중치를 바꿀 때마다 설정 파일을 다시 쓰므로, 켤 때 TTS_CONFIG 를 TTS_SERVER_CONFIG(apps/tts 기준, git 제외)로 복사해서 그걸 쓴다
TTS_CONFIG=../sample_vox2.yaml
TTS_SERVER_CONFIG=.tts-server.yaml
TTS_LANG=ko
# 참조 음성: 말투와 속도는 이 클립을 따라간다. _slow 는 원본(sample_vox2_ref.wav)을 0.8배속으로 늦춘 것으로,
# 이렇게 해야 합성 속도가 실제 내레이션 속도와 맞는다
#   ffmpeg -i sample_vox2_ref.wav -filter:a atempo=0.8 -ar 32000 sample_vox2_ref_slow.wav
TTS_REF_AUDIO=sample_vox2_ref_slow.wav
TTS_REF_TEXT_FILE=sample_vox2_ref.txt
# 음색 보조 참조 (공백으로 구분, 비워도 됨)
TTS_AUX_REFS="sample_vox2_aux1.wav sample_vox2_aux2.wav sample_vox2_aux3.wav sample_vox2_aux4.wav sample_vox2_aux5.wav sample_vox2_aux6.wav"
# 말 속도 (1.0 = 실제 내레이션 속도, 0.9 = 느리게, 1.1 = 빠르게)
TTS_SPEED=1.0
# 문장 사이 쉼(초). 0.1 = 촘촘, 0.3 = 기본, 0.7 = 여유 — 유사도·발음 변화 없음 (측정 2026-10-04)
TTS_FRAGMENT_INTERVAL=0.3
# 물음표 처리: "?" 를 그대로 보내면 끝음이 실제 질문(+1~2.5반음)보다 훨씬 높게(+8반음) 올라가서, 아래 문자로 바꿔 보낸다.
#   측정 2026-10-05 (송이 현재 모델, 끝 200ms - 문장 중앙음): "." -1.2 (그대로)  "," +0.5 (살짝)  "…" +1.9 (자연스럽게, 기본)  "?" +8.8 (길게)
#   "?!" "??" 는 "?" 와 같다. 넷 다 발음 오류 없음
TTS_QUESTION_END="…"
# 웹 테스트 화면 (./tts-web.sh): 주소, 포트, 속도 슬라이더의 최소 최대 간격
TTS_WEB_HOST=127.0.0.1
TTS_WEB_PORT=7860
TTS_WEB_SPEED_RANGE="0.8 1.2 0.05"
TTS_WEB_PAUSE_RANGE="0 1.5 0.05"
# 스타일 프리셋 목록 (첫 항목이 처음 화면 값): name, style(말투 id), strength(감정 강도), expressiveness(표현력), speed, pause
TTS_WEB_PRESETS_FILE=tts-presets.json
# 표현력 0·50·100 에서의 GPT top_k (50 = 합성 서버 기본 15). 측정 2026-10-05, 송이:
#   3 = 음역 -1.4반음, 테이크 간 길이 편차 절반 (안정적)   50 = 음역 +2.4반음, 발음 실수가 생김 (8개 중 1개 CER 27%)
#   temperature 는 0.7–1.3 에서 측정되는 차이가 없어 쓰지 않는다
TTS_WEB_TOPK_POINTS="3 15 50"
# 웹 화면의 목소리 목록 (첫 항목이 기본). 목소리마다 가중치(gpt_weights, sovits_weights — GPT-SoVITS 폴더 기준), 말투 목록 파일(styles_file)
#   목소리를 바꾸면 합성 서버가 가중치를 갈아 끼운다 (한 대본은 한 목소리라 대본마다 한 번)
#   model: 학습한 가중치 이름 (gpt+sovits 가중치 파일 이름). /voices 로 내보내며, 다시 학습하면 바꾼다 — 편집기가 예전 모델로 만든 음성을 가려낸다
#   말투 목록 파일의 각 항목: id, name, 합성 요청에 덮어쓸 params (ref_audio_path, prompt_text). 첫 항목(기본)은 aux_ref_audio_paths 도 넣는다.
#   나머지 말투는 style_aux (그 말투 클립들): 감정 강도만큼 기본 말투의 aux 클립을 이 클립으로 바꿔 보낸다 (100 = 전부)
#   post_filter (선택): 그 목소리의 후처리 필터, 없으면 아래 TTS_POST_FILTER
#   dereverb_agg (선택): 있으면 후처리 전에 방 울림을 걷어낸다 (UVR5 DeEcho-DeReverb, 숫자가 클수록 세게 0–20)
#     송강: 녹음한 방 울림을 모델이 그대로 배움 — 잔향/건조 에너지 비 -28dB(송이 실제 녹음 -53dB) → 5 로 -45.5dB,
#     유사도 0.900 → 0.899. 울림을 걷으면 고음이 살아나 treble +3dB 는 뺐다 (4kHz 위 -32.1dB, 실제 녹음 -33.3dB). 측정 2026-10-05
#     송강 post_filter: 학습 데이터와 같은 약한 afftdn (예전엔 + treble=g=3:f=3000 으로 먹먹함 보정 — 울림 제거 후 뺌)
#   위의 TTS_API_*, TTS_CONFIG, TTS_REF_*, TTS_AUX_REFS 는 송이 기준이며 voices-release.sh 가 묶음에 넣는다
TTS_VOICES_FILE=tts-voices.json
TTS_UVR5_DIR=GPT-SoVITS/tools/uvr5
TTS_DEREVERB_MODEL=GPT-SoVITS/tools/uvr5/uvr5_weights/VR-DeEchoDeReverb.pth
# 울림 제거 창 크기. 512(UVR5 기본) = 순간 메모리 6.2GB, 256 = 3.4GB, 시간 같음. 256 결과는 512 와 SNR 30.5dB 차이 (측정 2026-10-21, 송강 참조 음성)
TTS_DEREVERB_WINDOW=256
# 합성 결과에 거는 ffmpeg -af 필터 (비우면 후처리 없음, ffmpeg 는 apps/tts 폴더에서 돌린다)
#   80Hz 밑 웅웅거림(50/60Hz 험) 제거 → RNNoise(cb 모델, 70%만 섞어 자연스러운 공간감 유지) → 유튜브 음량(-16 LUFS)
#   측정: 쉼 구간 잡음 -3.5dB, 화자 유사도 변화 +0.004
TTS_POST_FILTER="highpass=f=80,arnndn=m=models/cb.rnnn:mix=0.7,loudnorm=I=-16:TP=-1.5:LRA=11"
# 웹 화면 결과 파일 비트레이트 (MP3, M4A/AAC) 와 샘플링 주파수 (loudnorm 이 192kHz 로 내보내 M4A 가 96kHz 가 되던 것을 고정)
TTS_MP3_BITRATE=128k
TTS_AAC_BITRATE=128k
TTS_OUT_RATE=48000
# 웹 화면의 문장 단위 합성 (tts-web.py). 합성 서버의 기본 cut5 는 쉼표마다 잘라 따로 합성하고 같은 길이의 쉼을 넣어
#   "안녕하세요," / "여러분." 처럼 끊겨 억양이 어색했다 (측정 2026-10-08: 5문장이 10조각, 공백 0.4–1.0초 14번).
#   이제 문장 끝(. ! ? …)에서만 나눠 통째로(cut0) 합성하고, SEG_MAX_CHARS 보다 긴 문장만 가운데 쉼표에서 나눈다.
#   SEG_MIN_SYL 음절보다 짧은 문장("네.")은 다음 문장에 붙인다 (아주 짧은 글은 합성이 불안정하고, 쉼은 모델이 스스로 정한다)
TTS_WEB_SEG_MAX_CHARS=60
TTS_WEB_SEG_MIN_SYL=6
# 문장 앞뒤에 모델이 스스로 넣는 숨·정적을 남기는 최대 길이(초). 실측 앞 0.2–0.5초, 뒤 0.1초 — 이보다 긴 것만 잘라 간격이 들쭉날쭉하지 않게 한다
TTS_WEB_LEAD_MAX=0.3
TTS_WEB_TAIL_MAX=0.25
# 쉼 길이: 문장 사이 = 화면의 '문장 사이 쉼'(TTS_FRAGMENT_INTERVAL), 긴 문장을 쉼표에서 나눈 조각 사이 = 그 ×0.4, 줄바꿈(문단) 사이 = ×2
TTS_WEB_PAUSE_COMMA_RATIO=0.4
TTS_WEB_PAUSE_PARA_RATIO=2
# 발음 검사: 문장마다 Whisper(faster-whisper, CPU int8) 로 받아 적어 CER 이 ASR_MAX_CER 보다 크거나(글자 2개까지는 봐줌)
#   조음 속도(쉼을 뺀 소리 나는 시간 기준 음절/초)가 RATE_RANGE 밖이면 다시 만들고(최대 RETRIES 번) 가장 나은 것을 쓴다.
#   small 모델: 읽기 1.5초, 26초 소리 받아 적기 2초, 정상 합성 CER 0.01–0.08 (측정 2026-10-08). 뭉개짐·헛소리·글자 빠짐 같은 큰 실패를 잡는 용도.
#   받아 적은 글은 보낸 글과 같은 규칙(숫자 → 한글 등)으로 다듬어 비교한다. 실제 송이 녹음 말 속도 중앙값 4.5음절/초 (p10 3.4, p90 5.6, 쉼 포함).
#   TTS_WEB_ASR_CHECK=0 이면 끔 (문장당 1–2초 절약)
TTS_WEB_ASR_CHECK=1
# 모델 폴더 (apps/tts 기준, setup-mac.sh 가 SETUP_ASR_URL 에서 받는다 — 인터넷 없이 읽도록 내려받아 둔다)
TTS_WEB_ASR_MODEL=models/faster-whisper-small
TTS_WEB_ASR_MAX_CER=0.35
TTS_WEB_RATE_RANGE="2.5 9.5"
TTS_WEB_RETRIES=2
# 합성 서버 한 문장 요청 제한 시간(초)
TTS_WEB_SYNTH_TIMEOUT=180
# 합성 서버가 켜져 있는지 확인하는 요청 제한 시간(초)
TTS_WEB_PING_TIMEOUT=3
# WAV 표본률. 정하지 않으면 loudnorm 이 속에서 올린 192kHz 그대로 나온다 (3초에 1.1MB). 44100 = OPENCUT 내보내기와 같음
TTS_WAV_SAMPLE_RATE=44100
# 웹 화면에서 한 번에 읽을 수 있는 최대 글자 수, 다운로드 파일 이름에 쓰는 앞 단어 수
TTS_WEB_MAX_CHARS=1000
TTS_WEB_FILENAME_WORDS=4
# 웹 화면에서 한 번에 만들 수 있는 최대 개수 (같은 문장을 여러 번 만들어 고를 때)
TTS_WEB_MAX_TAKES=10
