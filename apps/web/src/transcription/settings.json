{
	"model": {
		"huggingFaceId": "onnx-community/whisper-large-v3-turbo_timestamped",
		"dtype": {
			"encoder_model": "fp16",
			"decoder_model_merged": "fp16"
		}
	},
	"vad": {
		"huggingFaceId": "onnx-community/silero-vad",
		"dtype": "fp32",
		"windowSamples": 512,
		"contextSamples": 64,
		"threshold": 0.5,
		"minSilenceSeconds": 0.3,
		"minSpeechSeconds": 0.25,
		"speechPadSeconds": 0.2,
		"maxGroupSeconds": 28,
		"joinSeconds": 0.5,
		"refillMinSeconds": 1.5,
		"stateSize": 128
	},
	"local": {
		"modelPath": "/models/",
		"ortPath": "/ort/",
		"modelFiles": [
			"config.json",
			"generation_config.json",
			"preprocessor_config.json",
			"tokenizer.json",
			"tokenizer_config.json"
		],
		"ortFiles": [
			"ort-wasm-simd-threaded.jsep.mjs",
			"ort-wasm-simd-threaded.jsep.wasm"
		]
	},
	"prompt": {
		"maxTokens": 200
	},
	"correction": {
		"contextWords": [
			"큰술",
			"작은술",
			"숟가락",
			"스푼",
			"티스푼",
			"컵",
			"꼬집",
			"그램",
			"리터",
			"넣"
		],
		"contextSeconds": 3,
		"trustCount": 2,
		"maxPhraseWords": 3
	},
	"filter": {
		"maxRepeats": 2,
		"maxRepeatNgram": 4,
		"minSpeechOverlap": 0.5,
		"hallucinationPhrases": [
			"시청해주셔서감사합니다",
			"끝까지시청해주셔서감사합니다",
			"구독과좋아요부탁드립니다",
			"구독좋아요알림설정",
			"다음영상에서만나요",
			"자막제공",
			"한국어자막",
			"MBC뉴스",
			"KBS뉴스",
			"SBS뉴스",
			"thankyouforwatching",
			"pleasesubscribe"
		]
	},
	"captionLayout": {
		"shortForm": {
			"maxCharsPerLine": 12,
			"maxLines": 1,
			"minDuration": 0.6,
			"maxDuration": 3,
			"stripPunctuation": true
		},
		"longForm": {
			"maxCharsPerLine": 24,
			"maxLines": 1,
			"minDuration": 1,
			"maxDuration": 6,
			"stripPunctuation": false
		}
	},
	"captionFontSize": {
		"shortForm": 3.75,
		"longForm": 5
	}
}
