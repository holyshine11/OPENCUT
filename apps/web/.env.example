# start-mac.command가 처음 실행할 때 이 파일을 .env.local로 복사한다.

# Dev only: set to true to show React Scan render overlay
# NEXT_PUBLIC_REACT_SCAN=true

# 대본 읽기(TTS) 합성 서버 주소. TTS 저장소의 tts-web.sh가 띄운다. 없으면 대본 읽기 탭만 "서버 없음"으로 뜬다
TTS_URL=http://127.0.0.1:7860

# 미디어 패널의 폴더 버튼이 파일을 복사해 Finder로 여는 곳. <이 폴더>/<프로젝트>/<동영상|오디오|이미지>
MEDIA_FOLDER=~/Movies/OpenCut
